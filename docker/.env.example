# Copy to docker/.env and adjust.

# Data folder outside the repository: game, firmware, RPCS3 config and caches, extracted client modules
DUST_DATA=/srv/dust514-data

# CREST ports (8081 is only for the second local test client)
CREST_PORTS=80,443,8080

# Web admin (port 8088 by default); set a long random token when the server is reachable from the internet
ADMIN_PORT=8088
ADMIN_TOKEN=

# Game arguments for the host: auto login against the local CREST server, first character; -novsync stops the game
# waiting for VSync, so a slow tick is not rounded down to 30 or 20 Hz (the RPCS3 frame limit still caps it)
HOST_GAME_ARGS=-autologinserver=127.0.0.1:8080 -autologincharindex=0 -novsync

# Watchdog: hang detection starts after STARTUP_GRACE seconds (the first boot compiles the PPU/SPU caches)
STARTUP_GRACE=1200
HANG_TIMEOUT=180

# Parallel compile jobs for the RPCS3 build (0 = all cores)
BUILD_JOBS=0
